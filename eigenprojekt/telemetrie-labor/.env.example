# Vorlage für das Telemetrie-Labor. Als .env kopieren (macht einrichten.sh automatisch).
# In .env stehen nur Einstellungen. Passwort und Cookie-Schlüssel gehören in .env.password.
LABOR_PORT=5080
LABOR_MAX_MB=1500

# .env.password erzeugt  python3 labor.py passwort  (Rechte 600), Inhalt:
# LABOR_PASSWORT_HASH=pbkdf2$200000$<salt>$<hash>
# LABOR_GEHEIMNIS=<zufälliger Schlüssel für das Login-Cookie>
