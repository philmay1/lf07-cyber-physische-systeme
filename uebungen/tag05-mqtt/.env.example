# Vorlage für SENTINEL Funk. Diese Datei liegt im Git, die echten Dateien nicht.
#
# 1. Einstellungen: als .env neben diese Datei kopieren und anpassen.
#    Auf dem Pi passt alles so. Auf dem Notebook MQTT_HOST auf die Adresse des Pi setzen.
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_WS_PORT=9001
FUNK_PORT=5050

# 2. Passwörter: gehören NICHT in .env, sondern in eine eigene Datei .env.password (Rechte 600).
#    Auf dem Pi erzeugt sie  bash funk.sh schluessel  mit Zufallspasswörtern.
#    Das Notebook bekommt nur die Zeile für die Rolle sender (bash funk.sh notebook).
#
# MQTT_PASS_LOGGER=bitte-erzeugen
# MQTT_PASS_BOARD=bitte-erzeugen
# MQTT_PASS_BRUECKE=bitte-erzeugen
# MQTT_PASS_KEYPAD=bitte-erzeugen
# MQTT_PASS_SENDER=bitte-erzeugen
# MQTT_PASS_HANDY=bitte-erzeugen
